# Base URL of the Upcome backend (Auth API + authenticated event stream).
#
# The client uses this for passwordless email login, topic interests, and the
# authenticated event websocket (derived as ws(s)://<host>/user/events).
#
# Point it at your Upcome backend. NEXT_PUBLIC_* values are inlined at build
# time, so set this before `npm run build`.
NEXT_PUBLIC_UPCOME_API_URL=https://api.your-upcome-host.io
