# URL of the Upcome live-event WebSocket feed.
# The client connects here and expects JSON messages of the form:
#   { "topic": "NVDA", "event": "NVDA CEO Sells $10,000 in shares", "more-info": "https://upcomenew.io/234" }
#
# Leave the default to use the bundled mock feed (`npm run mock`).
NEXT_PUBLIC_UPCOME_WS_URL=ws://localhost:4001
